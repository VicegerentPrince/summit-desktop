<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Summit: dark slate with a glacier-teal accent.
  Syntax theme for bat and delta (syntect). Selectors use only what syntect
  understands: descendant paths, comma lists and "-" exclusions.

  Palette
    background #171c23   panel   #1d232c   raised  #28313d   border  #2a333f
    text       #dce3ea   bright  #f0f4f8   muted   #8693a1   dim     #5c6773
    comment    #6e7a88   teal    #4fd1c5   teal+   #81e6d9   blue    #7cb7ff
    purple     #b9a3f5   green   #84cc6a   amber   #e3b341   red     #f47067
    property   #c5cfd9

  syntect resolves a style per property: the deepest matching scope wins, then
  the longest selector. Rules that must cancel an inherited italic therefore
  carry an explicit empty fontStyle.
-->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Summit</string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>semanticClass</key>
	<string>theme.dark.summit</string>
	<key>settings</key>
	<array>
