[Unit]
Description=Keep the Summit desktop widgets laid out for every screen size
After=plasma-workspace.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/summit/layout/summit-layout.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
